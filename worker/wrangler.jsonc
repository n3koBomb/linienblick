{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linienblick",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*"
    ]
  }
}
